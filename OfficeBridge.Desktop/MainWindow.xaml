<Window Icon="Assets/OfficeBridge.ico" x:Class="OfficeBridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OfficeBridge Desktop"
        Height="820"
        Width="1180"
        MinHeight="720"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F4F7FB" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1F4E79"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2E75B6"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D9E2EC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#C7D2E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#C7D2E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SmallBrowseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,8"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="CheckBoxStyleSoft" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
    
        <Style x:Key="LanguageSwitchRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2E75B6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Margin" Value="3,0,3,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    CornerRadius="10"
                    Padding="16">
                <DockPanel LastChildFill="True">
                    <Border Width="200"
                            Height="78"
                            CornerRadius="10"
                            Background="White"
                            DockPanel.Dock="Left"
                            Margin="0,0,16,0"
                            Padding="6">
                        <Image Source="Assets/logo.png"
                               Stretch="Uniform"/>
                    </Border>

                    <DockPanel LastChildFill="True">
                        <StackPanel VerticalAlignment="Center"
                                    DockPanel.Dock="Left">
                            <TextBlock x:Name="HeaderTitleTextBlock"
                                       Text="Fast and Simple"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock x:Name="HeaderSubtitleTextBlock"
                                       Text="TAG Process document generation"
                                       FontSize="13"
                                       Foreground="#DCE6F2"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Modes -->
            <TabControl Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- STANDARD MODE -->
                <TabItem x:Name="StandardTabItem" Header="STANDARD">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Main data -->
                        <Border Grid.Row="0"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="ProjectDataTitleTextBlock" Text="Project Data" Style="{StaticResource SectionTitleStyle}"/>

                                    <StackPanel x:Name="LanguageSwitchPanel"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,12">
                                        <TextBlock x:Name="LanguageLabel"
                                                   Text="Language"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ComboBox x:Name="LanguageComboBox"
                                                  Width="90"
                                                  SelectedIndex="0"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="EN" Tag="English"/>
                                            <ComboBoxItem Content="HE" Tag="Hebrew"/>
                                            <ComboBoxItem Content="RU" Tag="Russian"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    </StackPanel>
                                    <TextBlock x:Name="ProjectNumberLabel" Text="Project Number" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="ProjectNumberTextBox" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock x:Name="ProductNameLabel" Text="Product Name" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TitleTextBox" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock x:Name="SigmaPnLabel" Text="Sigma P/N" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SigmaPnTextBox" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Text="Serial Number" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SerialNumberTextBox" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock x:Name="ProjectManagerLabel" Text="Project Manager" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="ProjectManagerTextBox" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Text="Production Quantity" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="ProductionQuantityTextBox" Style="{StaticResource InputTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="DocumentOptionsTitleTextBlock" Text="Document Options" Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock x:Name="RevisionLabel" Text="Revision" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="RevisionTextBox" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Text="Closure Status" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="ClosureStatusComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="FULL"/>
                                        <ComboBoxItem Content="PARTIAL"/>
                                    </ComboBox>

                                                                        <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <GroupBox Grid.Column="0"
                                                  Header="Document Package"
                                                  Padding="12"
                                                  BorderBrush="#B7C7D9"
                                                  BorderThickness="1.5">
                                            <StackPanel>
                                                <CheckBox x:Name="MechanicalDrawingCheckBox"
                                                          Content="Mechanical Drawing"
                                                          IsChecked="True"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="ElectricalDrawingCheckBox"
                                                          Content="Electrical Drawing"
                                                          IsChecked="True"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="SpecificationCheckBox"
                                                          Content="PART LIST"
                                                          IsChecked="True"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="DatasheetsCheckBox"
                                                          Content="DATASHEETS"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="PicturesCheckBox"
                                                          Content="Pictures"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <Border Grid.Column="1"
                                                Width="1"
                                                Margin="0,4,0,4"
                                                Background="#D7E3F0"/>

                                        <GroupBox Grid.Column="2"
                                                  Header="Requirement"
                                                  Padding="12"
                                                  BorderBrush="#8FB3D9"
                                                  BorderThickness="2"
                                                  Background="#FAFCFF">
                                            <StackPanel>
                                                <CheckBox x:Name="PullTestCheckBox"
                                                          Content="PULL TEST"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="FaiCheckBox"
                                                          Content="FAI"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="Fai2CheckBox"
                                                          Content="FAI2"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="Fai3CheckBox"
                                                          Content="FAI3"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="InspectorRequirementCheckBox"
                                                          Content="Inspector Requirement"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="AutomaticCheckCheckBox"
                                                          Content="Automatic Test"
                                                          IsChecked="True"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="ExternalElectricalTestCheckBox"
                                                          Content="External Electrical TEST"
                                                          Margin="0,4,0,0"/>

                                                <CheckBox x:Name="AdditionalRequirementsCheckBox"
                                                          Content="Additional requirements"
                                                          Margin="0,4,0,0" Checked="AdditionalRequirementsCheckBox_Changed" Unchecked="AdditionalRequirementsCheckBox_Changed"/>

                                                <TextBlock x:Name="AdditionalRequirementsTextLabel"
                                                           Text="Additional requirements text"
                                                           Margin="22,8,0,0"
                                                           Visibility="Collapsed"/>

                                                <TextBox x:Name="AdditionalRequirementsTextBox"
                                                         MinHeight="75"
                                                         Margin="22,4,0,0"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Visibility="Collapsed"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Standard paths and actions -->
                        <Border Grid.Row="2"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="StandardGenerationTitleTextBlock" Text="Standard Generation" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Template Path" Style="{StaticResource FieldLabelStyle}"/>
                                <DockPanel>
                                    <Button x:Name="BrowseTemplateButton"
                                            Content="..."
                                            Style="{StaticResource SmallBrowseButtonStyle}"
                                            DockPanel.Dock="Right"
                                            Click="BrowseTemplateButton_Click"/>
                                    <TextBox x:Name="TemplatePathTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"/>
                                </DockPanel>

                                <TextBlock Text="Output Folder" Style="{StaticResource FieldLabelStyle}"/>
                                <DockPanel>
                                    <Button x:Name="BrowseOutputButton"
                                            Content="..."
                                            Style="{StaticResource SmallBrowseButtonStyle}"
                                            DockPanel.Dock="Right"
                                            Click="BrowseOutputButton_Click"/>
                                    <TextBox x:Name="OutputFolderTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"/>
                                </DockPanel>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="GenerateButton"
                                            Content="Generate DOCX + PDF"
                                            Width="220"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="GenerateButton_Click"/>

                                    <Button x:Name="OpenOutputButton"
                                            Content="Open Output"
                                            Width="190"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenOutputButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ADVANCED MODE -->
                <TabItem x:Name="AdvancedTabItem" Header="ADVANCED">
                    <Border Margin="0,14,0,0"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="AdvancedSettingsTitleTextBlock" Text="Advanced Settings" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="JSON Path" Style="{StaticResource FieldLabelStyle}"/>
                            <DockPanel>
                                <Button x:Name="BrowseJsonButton"
                                        Content="..."
                                        Style="{StaticResource SmallBrowseButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Click="BrowseJsonButton_Click"/>
                                <TextBox x:Name="JsonPathTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"/>
                            </DockPanel>

                            <TextBlock Text="Archive Folder" Style="{StaticResource FieldLabelStyle}"/>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="BrowseArchiveButton"
                                        Content="..."
                                        Style="{StaticResource SmallBrowseButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Click="BrowseArchiveButton_Click"/>
                                <TextBox x:Name="ArchiveFolderTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,18,0,0"
                                        VerticalAlignment="Top">

                                <Button x:Name="LoadJsonButton"
                                        Content="Load JSON"
                                        Width="140"
                                        Height="42"
                                        Padding="16,0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="LoadJsonButton_Click"/>

                                <Button x:Name="SaveJsonToArchiveButton"
                                        Content="Save JSON to Archive"
                                        Width="170"
                                        Height="42"
                                        Padding="16,0"
                                        Margin="8,0,8,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveJsonToArchiveButton_Click"/>

                                <Button x:Name="OpenArchiveButton"
                                        Content="Open Archive"
                                        Width="140"
                                        Height="42"
                                        Padding="16,0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OpenArchiveButton_Click"/>

                            </StackPanel>

                            <TextBlock Text="Advanced mode is intended for loading data from JSON and changing archive storage location."
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Log -->
            <Border Grid.Row="4"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock x:Name="ExecutionLogTitleTextBlock" Text="Execution Log"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   DockPanel.Dock="Left"/>
                        <TextBlock Text="Status messages and errors"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="14,3,0,0"/>
                    </DockPanel>

                    <TextBox Grid.Row="2"
                             x:Name="LogTextBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             Background="#F8FAFC"
                             BorderBrush="#D6DEE8"
                             BorderThickness="1"
                             Padding="10"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
































